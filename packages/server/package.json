{
  "name": "@cbz-tool/server",
  "version": "1.4.3",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin.js",
    "dev": "nodemon --watch . --ext ts --exec \"tsc && node dist/bin.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "fast-xml-parser": "5.7.2",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "sharp": "^0.35.0",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.0",
    "@types/sharp": "^0.31.1",
    "@types/yauzl": "^2.10.3",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
